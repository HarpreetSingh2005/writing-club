# =====================================================================
# Copy this file to `.env` and fill in your real keys. Never commit `.env`.
# =====================================================================

# ----------------- LLM Provider API Keys -----------------
# Single key:
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key
NVIDIA_API_KEY=your_nvidia_key

# Multiple keys (comma-separated) for automatic failover:
# GEMINI_API_KEYS=key1,key2,key3
# OPENAI_API_KEYS=key1,key2

# Or numbered keys (checked in order until one is missing):
# GEMINI_API_KEY_1=key1
# GEMINI_API_KEY_2=key2

# ----------------- Local LLM Fallback (Ollama) -----------------
# Final safety net used only when every cloud provider fails.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true

# ----------------- Optional Web Research (SearXNG) -----------------
# Leave SEARXNG_URL empty to disable web research entirely.
SEARXNG_URL=http://localhost:8080
SEARXNG_TIMEOUT=10
